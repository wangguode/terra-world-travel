{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terra-world-travel",
  "compatibility_date": "2024-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./out"
  },
  "routes": [
    {
      "pattern": "terra.statementflow.win",
      "custom_domain": true
    },
    {
      "pattern": "terra.statementflow.win/*",
      "zone_name": "statementflow.win"
    }
  ]
}
